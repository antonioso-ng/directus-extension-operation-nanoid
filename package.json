{
	"name": "directus-extension-operation-nanoid",
	"description": "Generate a NanoID in your Directus flows.",
	"type": "module",
	"version": "1.0.9",
	"license": "MIT",
	"icon": "extension",
	"homepage": "https://github.com/antonioso-ng/directus-extension-operation-nanoid.git#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/antonioso-ng/directus-extension-operation-nanoid.git"
	},
	"bugs": {
		"url": "https://github.com/antonioso-ng/directus-extension-operation-nanoid/issues"
	},
	"author": {
		"name": "Antonio Song",
		"email": "hello@antonioso.ng"
	},
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-operation",
		"operation-nanoid",
		"nanoid"
	],
	"files": [
		"dist"
	],
	"directus:extension": {
		"type": "operation",
		"path": {
			"app": "dist/app.js",
			"api": "dist/api.js"
		},
		"source": {
			"app": "src/app.ts",
			"api": "src/api.ts"
		},
		"host": "^10.10.0",
		"hidden": false
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"validate": "directus-extension validate",
		"link": "directus-extension link"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "18.1.1",
		"@types/bun": "1.4.4",
		"@types/node": "26.6.6",
		"typescript": "7.0.2",
		"vue": "3.5.45"
	},
	"dependencies": {
		"nanoid": "6.0.2"
	},
	"packageManager": "bun@1.4.4"
}
